# The table. Leave both empty and the site runs the practice table only.
NEXT_PUBLIC_CLUCKR_ADDRESS=
NEXT_PUBLIC_TOKEN_ADDRESS=
NEXT_PUBLIC_TOKEN_SYMBOL=CLUCK

# The house (server/). Hands out commitments and reveals seeds.
NEXT_PUBLIC_HOUSE_URL=http://localhost:8795

# Robinhood Chain by default; 31337 + the local RPC for the rehearsal table.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com

# ETH forwarded to the browser's session key by the first round (gas for the lifts).
NEXT_PUBLIC_GAS_STIPEND_ETH=0.0005

# Where the token trades, shown under "The coop" when set.
NEXT_PUBLIC_TRADE_URL=
NEXT_PUBLIC_SITE_URL=https://cluckr.fun
