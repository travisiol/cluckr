# The house. Never commit a real HOUSE_KEY.
PORT=8795
DB_PATH=./data/house.sqlite
ORIGIN=*

# The chain and the table.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663
CLUCKR_ADDRESS=
# Signs commitments and pays for the janitor's reveals. A KMS in production.
HOUSE_KEY=

# Commitments: lifetime and how many a player may hold unused.
COMMIT_MINUTES=15
COMMITS_PER_PLAYER=3

# The janitor: how often it sweeps, how long a lift may sit unsettled before
# it posts the seed itself. JANITOR=false answers HTTP only.
JANITOR=true
JANITOR_SECONDS=15
REVEAL_AFTER_SECONDS=45
